{
  "name": "ingredi-findr-v2",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/backend/*.test.ts tests/backend/*.test.js tests/data-pipeline/*.test.js tests/frontend/*.test.js tests/scrapers/*.test.js",
    "data:audit": "node scripts/audit_data.js",
    "data:normalize": "node scripts/normalize_products.js",
    "db:migrate": "node scripts/db_migrate.js",
    "db:import:legacy": "node scripts/import_legacy_catalog.js",
    "scrape:smoke": "node scripts/run_scrape.js --retailer=sephora --limit=5 --dry-run",
    "scrape:sephora": "node scripts/run_scrape.js --retailer=sephora --limit=5",
    "scrape:sephora:count": "node scripts/run_scrape.js --retailer=sephora --all --count-only",
    "scrape:sephora:batch": "node scripts/run_scrape.js --retailer=sephora --limit=100 --skip-existing-images",
    "scrape:sephora:all": "node scripts/run_scrape.js --retailer=sephora --all --skip-existing-images",
    "scrape:ulta": "node scripts/run_scrape.js --retailer=ulta --limit=5",
    "scrape:ulta:count": "node scripts/run_scrape.js --retailer=ulta --all --count-only",
    "scrape:ulta:batch": "node scripts/run_scrape.js --retailer=ulta --limit=100 --skip-existing-images",
    "scrape:ulta:all": "node scripts/run_scrape.js --retailer=ulta --all --skip-existing-images",
    "scrape:ulta:all:shard0": "node scripts/run_scrape.js --retailer=ulta --all --skip-existing-images --shard=0 --shards=4",
    "scrape:ulta:all:shard1": "node scripts/run_scrape.js --retailer=ulta --all --skip-existing-images --shard=1 --shards=4",
    "scrape:ulta:all:shard2": "node scripts/run_scrape.js --retailer=ulta --all --skip-existing-images --shard=2 --shards=4",
    "scrape:ulta:all:shard3": "node scripts/run_scrape.js --retailer=ulta --all --skip-existing-images --shard=3 --shards=4"
  },
  "dependencies": {
    "next": "^14.2.30",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "typescript": "^5.8.3"
  }
}
